# UNTESTED — SYNTAX ONLY.
# This Sentinel policy has been written against the tfplan/v2 import
# documentation and reviewed by eye. It has NOT been executed with the Sentinel
# CLI or in HCP Terraform. Run `sentinel test` with your own mocks before use.
#
# Purpose: EBS volumes and RDS instances must be encrypted at rest. Mirrors the
# AWS half of the OPA policy terraform/storage_encryption_required.
#
# Controls: CIS AWS Foundations Benchmark 2.2.1 and 2.3.1 · ISO/IEC 27001:2022 A.8.24 · NIST CSF 2.0 PR.DS-01

import "tfplan/v2" as tfplan

planned = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
	(rc.change.actions contains "create" or rc.change.actions contains "update")
}

unencrypted_volumes = filter planned as _, rc {
	rc.type is "aws_ebs_volume" and
	(rc.change.after.encrypted else false) is not true
}

unencrypted_databases = filter planned as _, rc {
	rc.type is "aws_db_instance" and
	(rc.change.after.storage_encrypted else false) is not true
}

print_violations = func() {
	for unencrypted_volumes as address, _ {
		print("DENY:", address, "must set encrypted = true")
	}
	for unencrypted_databases as address, _ {
		print("DENY:", address, "must set storage_encrypted = true")
	}
	return true
}

main = rule when print_violations() {
	length(unencrypted_volumes) is 0 and length(unencrypted_databases) is 0
}
